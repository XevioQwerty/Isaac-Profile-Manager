<Project>

  <!--
    One version for the whole product.

    The app and the Steam helper ship together and must be replaced together â€”
    a mismatched pair is the failure mode where the app cannot do Workshop work
    and nobody can tell which half is stale. Versioning them from one place
    makes "is this the right build?" answerable by reading either exe.

    Package.ps1 reads this file, so the zip name, the installer name and both
    executables all follow it. Bump here and nowhere else.
  -->
  <PropertyGroup>
    <Version>1.2.0</Version>
    <Product>Isaac Profile Manager</Product>
    <Company>XevioQwerty</Company>
  </PropertyGroup>

</Project>
