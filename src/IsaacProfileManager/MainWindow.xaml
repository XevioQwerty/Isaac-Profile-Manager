<Window x:Class="IsaacProfileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IsaacProfileManager.Views"
        Title="Isaac Profile Manager" Height="700" Width="1120" MinHeight="540" MinWidth="920"
        Icon="app.ico"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- An existing config that cannot be used -->
        <Border Grid.Row="0" Background="#2A1F1F" BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,1"
                Padding="16,12" Visibility="{Binding ShowConfigError, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
                <TextBlock Text="Config not loaded" Style="{StaticResource Heading}"/>
                <TextBlock Text="{Binding ConfigErrorText}" Style="{StaticResource Dim}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Locate isaac-profiles.json..." Command="{Binding LocateConfigCommand}" Margin="0,0,8,0"/>
                    <Button Content="Retry" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Nothing configured yet: the window is the setup wizard -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="2" Background="{StaticResource Bg}"
              Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVisible}}">
            <views:SetupView DataContext="{Binding Setup}"/>
            <Button Content="I already have a config file..." Command="{Binding LocateConfigCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,16"/>
        </Grid>

        <!--
            The rail. Play first, because "what happens when I press Launch" is
            the question the app exists to answer; everything else is somewhere
            you go to change one of the things that card shows.
        -->
        <TabControl Grid.Row="1" x:Name="Tabs" Style="{StaticResource RailTabControl}"
                    SelectionChanged="OnTabChanged">
            <TabItem Header="Play" Style="{StaticResource RailTab}">
                <views:PlayView DataContext="{Binding Play}" Margin="14,0,14,0"/>
            </TabItem>
            <TabItem Header="Mods" Style="{StaticResource RailTab}">
                <!-- Get mods, keep mods, choose mods: one concept at three stages -->
                <TabControl x:Name="ModsTabs" Padding="0" Margin="14,10,14,0" SelectionChanged="OnModsTabChanged">
                    <TabItem Header="Mod profiles">
                        <views:ModProfilesView DataContext="{Binding ModProfiles}"/>
                    </TabItem>
                    <TabItem Header="Library">
                        <views:LibraryView DataContext="{Binding Library}"/>
                    </TabItem>
                    <TabItem Header="Workshop">
                        <views:WorkshopView DataContext="{Binding Workshop}"/>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="Saves" Style="{StaticResource RailTab}">
                <views:SavesView DataContext="{Binding Saves}" Margin="14,0,14,0"/>
            </TabItem>
            <TabItem Header="Game" Style="{StaticResource RailTab}">
                <views:BuildVariantsView DataContext="{Binding BuildVariants}" Margin="14,0,14,0"/>
            </TabItem>
            <TabItem Header="Diagnose" Style="{StaticResource RailTab}">
                <views:DebugView DataContext="{Binding Debug}" Margin="14,0,14,0"/>
            </TabItem>
            <TabItem Header="Settings" Style="{StaticResource RailTab}">
                <views:SettingsView DataContext="{Binding Settings}" Margin="14,0,14,0"/>
            </TabItem>
        </TabControl>

        <!-- Status bar. Most support questions answer themselves if this is on screen. -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Profile:" Style="{StaticResource Dim}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding ActiveProfileText}" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- The pairing, as one dot: green matches, amber recommends, red blocks -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0" ToolTip="{Binding GuardText}">
                    <Ellipse Width="9" Height="9" Fill="{Binding GuardBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="Saves:" Style="{StaticResource Dim}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding ActiveSaveSetText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Build folder:" Style="{StaticResource Dim}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding ActiveBuildText}" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Launcher will start:" Style="{StaticResource Dim}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding LaunchModeText}" FontWeight="SemiBold"/>
                </StackPanel>

                <TextBlock Grid.Column="4" Text="{Binding GameRunningText}" Margin="0,0,20,0"
                           Foreground="{Binding IsIsaacRunning, Converter={StaticResource RunningBrush}}"/>

                <TextBlock Grid.Column="5" Text="{Binding StatusMessage}" Style="{StaticResource Dim}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                <Button Grid.Column="6" Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,3"/>
            </Grid>
        </Border>
    </Grid>
</Window>
