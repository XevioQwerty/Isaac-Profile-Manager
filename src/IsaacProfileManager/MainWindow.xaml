<Window x:Class="IsaacProfileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IsaacProfileManager.Views"
        Title="Isaac Profile Manager" Height="680" Width="1040" MinHeight="520" MinWidth="880"
        Icon="app.ico"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- An existing config that cannot be used -->
        <Border Grid.Row="0" Background="#2A1F1F" BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,1"
                Padding="16,12" Visibility="{Binding ShowConfigError, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
                <TextBlock Text="Config not loaded" Style="{StaticResource Heading}"/>
                <TextBlock Text="{Binding ConfigErrorText}" Style="{StaticResource Dim}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Locate isaac-profiles.json..." Command="{Binding LocateConfigCommand}" Margin="0,0,8,0"/>
                    <Button Content="Retry" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Nothing configured yet: the window is the setup wizard -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="2" Background="{StaticResource Bg}"
              Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVisible}}">
            <views:SetupView DataContext="{Binding Setup}"/>
            <Button Content="I already have a config file..." Command="{Binding LocateConfigCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,16"/>
        </Grid>

        <!-- Launch button, sat in the tab strip's spare space on the right -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0" Panel.ZIndex="1">
            <Button Command="{Binding LaunchGameCommand}" Style="{StaticResource PrimaryButton}"
                    Padding="26,10" FontSize="15">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x25B6;" FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0"
                               Foreground="White"/>
                    <TextBlock Text="Launch Isaac" FontWeight="SemiBold" FontSize="15" Foreground="White"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding LaunchButtonHint}" Style="{StaticResource Dim}"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Padding="0" Margin="12,10,12,0">
            <TabItem Header="Mod profiles">
                <views:ModProfilesView DataContext="{Binding ModProfiles}"/>
            </TabItem>
            <TabItem Header="Library">
                <views:LibraryView DataContext="{Binding Library}"/>
            </TabItem>
            <TabItem Header="Workshop">
                <views:WorkshopView DataContext="{Binding Workshop}"/>
            </TabItem>
            <TabItem Header="Build">
                <views:BuildVariantsView DataContext="{Binding BuildVariants}"/>
            </TabItem>
            <TabItem Header="Saves">
                <views:SavesView DataContext="{Binding Saves}"/>
            </TabItem>
            <TabItem Header="Debug">
                <views:DebugView DataContext="{Binding Debug}"/>
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView DataContext="{Binding Settings}"/>
            </TabItem>
        </TabControl>

        <!-- Status bar. Most support questions answer themselves if this is on screen. -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Profile:" Style="{StaticResource Dim}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding ActiveProfileText}" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Build folder:" Style="{StaticResource Dim}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding ActiveBuildText}" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Launcher will start:" Style="{StaticResource Dim}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding LaunchModeText}" FontWeight="SemiBold"/>
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding GameRunningText}" Margin="0,0,20,0"
                           Foreground="{Binding IsIsaacRunning, Converter={StaticResource RunningBrush}}"/>

                <TextBlock Grid.Column="4" Text="{Binding StatusMessage}" Style="{StaticResource Dim}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                <Button Grid.Column="5" Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,3"/>
            </Grid>
        </Border>
    </Grid>
</Window>
