<Window x:Class="IsaacProfileManager.Views.ShareImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import a shared mod set" Height="640" Width="820" MinHeight="480" MinWidth="640"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Import a shared mod set" Style="{StaticResource Heading}"/>
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Paste a share code (starts with IPM1-), or a Steam collection id or link — or open a profile file someone sent you. Whatever is missing from your library is downloaded from the Workshop. A share code carries hashes so a byte-for-byte match can be proven; a collection can only say which mods are in it."/>
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="CodeBox" Height="90" Margin="0,0,0,10"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" Background="{StaticResource PanelAlt}"
                 Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="ReadButton" Content="Read it" Click="OnRead" Margin="0,0,8,0"/>
            <Button x:Name="PasteButton" Content="Paste from clipboard" Click="OnPaste" Margin="0,0,8,0"/>
            <Button x:Name="FileButton" Content="Open a profile file..." Click="OnOpenFile" Margin="0,0,16,0"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource Mono}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PlanList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Entry}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock Grid.Column="1" Text="{Binding Summary}" Margin="12,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NeedsFetch}" Value="True">
                                                    <Setter Property="Foreground" Value="#E8B54A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="Unfetchable">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox x:Name="BuildProfileBox" Content="Also build a profile called"
                          VerticalAlignment="Center" IsChecked="True" Margin="0,0,8,0"/>
                <TextBox x:Name="ProfileNameBox" Width="220" VerticalAlignment="Center"
                         Background="{StaticResource PanelAlt}" Foreground="{StaticResource Text}"
                         BorderBrush="{StaticResource Border}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Import resubscribes to the missing mods, takes the files into your library, and unsubscribes again. Steam must be running and Isaac must be closed.&#10;&#10;Just subscribe in Steam does only the first step and leaves them subscribed, so Steam downloads them normally in the background — use it if Import will not fetch. Those mods then behave like any ordinary subscription, including being laid into the active profile when the game launches."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ProgressText" Style="{StaticResource Mono}" VerticalAlignment="Center"
                           Margin="0,0,16,0" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                <Button x:Name="SubscribeButton" Content="Just subscribe in Steam" Click="OnSubscribeOnly"
                        IsEnabled="False" Margin="0,0,8,0"/>
                <Button x:Name="ImportButton" Content="Import" Click="OnImport" IsEnabled="False"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" MinWidth="90"/>
                <Button x:Name="CloseButton" Content="Close" Click="OnClose" MinWidth="90"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
