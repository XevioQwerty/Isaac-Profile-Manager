<UserControl x:Class="IsaacProfileManager.Views.SavesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:IsaacProfileManager.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,10">
        <StackPanel>
            <views:GuideCard Title="A save set is your slots plus the mod data behind them"
                         Text="Capture what is live, start a fresh one, or load a set. Every re-capture files the previous revision under History. Import a save file to put a downloaded save into a slot; export a set as one file to move it to another machine."/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sets, capture, backups -->
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Save sets" Style="{StaticResource Heading}"/>
                        <ListBox ItemsSource="{Binding Sets}" SelectedItem="{Binding Selected}" MinHeight="140" MaxHeight="260">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding BuildText}" Style="{StaticResource Dim}"/>
                                            <TextBlock Text="{Binding SlotsText}" Style="{StaticResource Dim}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding PlayersText}" Style="{StaticResource Dim}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="New save set" Style="{StaticResource Heading}"/>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Name it, then choose whether it starts from the save you have now or from nothing - separate unlock states for, say, vanilla online and vanilla solo."/>
                        <TextBlock Text="Name" Style="{StaticResource Dim}"/>
                        <TextBox Text="{Binding NewSetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Text="Players (comma separated)" Style="{StaticResource Dim}"/>
                        <TextBox Text="{Binding NewSetPlayers, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Text="Notes" Style="{StaticResource Dim}"/>
                        <TextBox Text="{Binding NewSetNotes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="52" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Capture what is live" Command="{Binding CaptureCommand}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Start a fresh save" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding StartFreshCommand}"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Capture copies the live files into the set and changes nothing - safe whatever Steam Cloud is doing."/>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                                   Text="Start a fresh save backs up the live files and clears them, so Isaac writes a new save next launch. The set stays empty until you come back and capture it."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Bring a set in" Style="{StaticResource Heading}"/>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="A set exported from another machine, or from someone you play with, arrives as one .ipmsave file. It is added to the list; the live saves do not change until you load it, and every check runs then."/>
                        <Button Content="Import a .ipmsave file..." Command="{Binding ImportPackCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Lanes on the other machine, per set -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasSync, Converter={StaticResource BoolToVisible}}">
                    <StackPanel>
                        <TextBlock Text="Sync between your machines" Style="{StaticResource Heading}"/>
                        <TextBlock Text="{Binding SyncSummary}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding SyncStatuses}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding SetName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource Dim}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Pull" VerticalAlignment="Center" Margin="8,0,0,0"
                                                Command="{Binding DataContext.PullStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanPull, Converter={StaticResource BoolToVisible}}"
                                                ToolTip="Take this revision. A set that is not here yet is created; a fork comes in as a separate set."/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel>
                            <Button Content="Check" Command="{Binding CheckSyncCommand}" Margin="0,0,8,8"/>
                            <Button Content="Push selected" Command="{Binding PushSelectedCommand}" Margin="0,0,8,8"
                                    ToolTip="Send the selected set's current revision to your other machine."/>
                            <Button Content="Pull selected" Command="{Binding PullSelectedCommand}" Margin="0,0,8,8"
                                    ToolTip="Take the newer revision from the other machine. A fork comes in as a separate set."/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                                   Text="Set up under Settings. The Play screen does the same for the set that is live, and does it by itself in Automatic mode."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Backups" Style="{StaticResource Heading}"/>
                        <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,8"
                                   Text="Taken automatically before every swap, timestamped to the second. REPENTOGON's own save_backups only keeps one per day and overwrites it."/>
                        <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" MaxHeight="130" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Back up now" Command="{Binding BackupNowCommand}" Margin="0,0,8,0"/>
                            <Button Content="Restore selected" Command="{Binding RestoreCommand}" Margin="0,0,8,0"/>
                            <Button Content="Delete selected" Command="{Binding DeleteBackupCommand}" Margin="0,0,8,0"
                                    ToolTip="Deletes that backup folder for good. Nothing else in this tab is unrecoverable."/>
                            <Button Content="Open backups folder" Command="{Binding OpenBackupsFolderCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Gate + detail -->
            <StackPanel Grid.Column="1">

                <!-- The precondition, stated plainly -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Before you can switch saves" Style="{StaticResource Heading}"/>
                        <!-- Steam Cloud only matters when the saves are Steam's -->
                        <StackPanel Visibility="{Binding CloudApplies, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="{Binding CloudStateText}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,10"
                                       Text="With Steam Cloud on, Steam owns these files and may restore the set you just replaced — silently, and possibly merging one save's unlocks into another. Save switching is only supported with Cloud off for Isaac."/>
                        </StackPanel>

                        <TextBlock Text="{Binding CloudIrrelevantText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding CloudApplies, Converter={StaticResource BoolToCollapsed}}"/>

                        <Border Background="#2A2519" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="10" Margin="0,0,0,10"
                                Visibility="{Binding ShowCloudStaleness, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="{Binding StalenessText}"/>
                        </Border>

                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="Turn Cloud off for me" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding TurnCloudOffCommand}" Margin="0,0,8,8"
                                    Visibility="{Binding CloudApplies, Converter={StaticResource BoolToVisible}}"/>
                            <Button Content="Open Steam properties for Isaac" Command="{Binding OpenSteamPropertiesCommand}" Margin="0,0,8,8"
                                    Visibility="{Binding CloudApplies, Converter={StaticResource BoolToVisible}}"/>
                            <Button Content="Re-check" Command="{Binding RecheckCommand}" Margin="0,0,8,8"/>
                            <Button Content="Open save folder" Command="{Binding OpenLiveFolderCommand}" Margin="0,0,8,8"/>
                            <Button Content="Open save sets folder" Command="{Binding OpenSetsFolderCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding TurnCloudOffHint}" Style="{StaticResource Dim}" Margin="0,0,0,10"
                                   Visibility="{Binding CloudApplies, Converter={StaticResource BoolToVisible}}"/>

                        <CheckBox IsChecked="{Binding CloudAcknowledged}" Margin="0,0,0,4"
                                  Content="I have checked in Steam myself — Cloud is off for Isaac"
                                  Visibility="{Binding CloudApplies, Converter={StaticResource BoolToVisible}}"/>
                        <TextBlock Style="{StaticResource Dim}" Margin="22,0,0,10"
                                   Visibility="{Binding CloudApplies, Converter={StaticResource BoolToVisible}}"
                                   Text="Use this if Steam's dialog says off but the file above still says on. It overrides the Cloud check only — the game-running and build checks still apply."/>

                        <Border Background="#2A2519" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="10" Margin="0,0,0,10"
                                Visibility="{Binding SaveFolderLooksWrong, Converter={StaticResource BoolToVisible}}">
                            <StackPanel>
                                <TextBlock Text="No save files in this folder" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SaveFolderWarning}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Choose the save folder..." Margin="0,0,8,0"
                                            Command="{Binding ChooseSaveFolderCommand}"/>
                                    <Button Content="Re-check" Command="{Binding RecheckCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Live save folder" Style="{StaticResource Dim}"/>
                        <TextBlock Text="{Binding LiveFolderText}" Style="{StaticResource Mono}"/>
                        <TextBlock Text="{Binding SaveFolderSourceText}" Style="{StaticResource Dim}"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Change..." Command="{Binding ChooseSaveFolderCommand}" Margin="0,0,8,0"/>
                            <Button Content="Work it out again" Command="{Binding ClearSaveFolderCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LastSyncText}" Style="{StaticResource Dim}" Margin="0,4,0,0"
                                   Visibility="{Binding LastSyncText, Converter={StaticResource StringToVisible}}"/>

                        <TextBlock Text="Files live right now" Style="{StaticResource Dim}" Margin="0,10,0,2"/>
                        <ItemsControl ItemsSource="{Binding LiveFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Mono}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="What they hold" Style="{StaticResource Dim}" Margin="0,8,0,2"
                                   Visibility="{Binding HasLiveSlots, Converter={StaticResource BoolToVisible}}"/>
                        <ItemsControl ItemsSource="{Binding LiveSlots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" MinWidth="160"/>
                                        <TextBlock Text="{Binding Summary.Summary}" Style="{StaticResource Dim}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Selected set -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Selected.Name}" FontSize="18" FontWeight="SemiBold"/>

                        <UniformGrid Columns="4" Margin="0,10,0,10">
                            <StackPanel>
                                <TextBlock Text="Build" Style="{StaticResource Dim}"/>
                                <TextBlock Text="{Binding Selected.BuildText}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Slots" Style="{StaticResource Dim}"/>
                                <TextBlock Text="{Binding Selected.SlotsText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Mod profile" Style="{StaticResource Dim}"/>
                                <TextBlock Text="{Binding Selected.ModProfile}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Captured" Style="{StaticResource Dim}"/>
                                <TextBlock Text="{Binding Selected.CapturedText}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="Players" Style="{StaticResource Dim}"/>
                        <TextBlock Text="{Binding Selected.PlayersText}" Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding Selected.Notes}" Style="{StaticResource Dim}" Margin="0,0,0,8"
                                   Visibility="{Binding Selected.Notes, Converter={StaticResource StringToVisible}}"/>

                        <TextBlock Text="Files" Style="{StaticResource Dim}"/>
                        <TextBlock Text="{Binding Selected.FilesText}" Style="{StaticResource Mono}" Margin="0,0,0,6"/>

                        <TextBlock Text="{Binding Selected.CarriedText}" Style="{StaticResource Dim}" Margin="0,0,0,4"
                                   Visibility="{Binding Selected.CarriedText, Converter={StaticResource StringToVisible}}"/>
                        <TextBlock Text="{Binding Selected.RevisionText}" Style="{StaticResource Dim}" Margin="0,0,0,10"
                                   Visibility="{Binding Selected.RevisionText, Converter={StaticResource StringToVisible}}"/>

                        <!-- The unlock files parsed: evidence of what the set holds -->
                        <TextBlock Text="What is in it" Style="{StaticResource Dim}" Margin="0,0,0,2"
                                   Visibility="{Binding HasSetSlots, Converter={StaticResource BoolToVisible}}"/>
                        <ItemsControl ItemsSource="{Binding SetSlots}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" MinWidth="160"/>
                                        <TextBlock Text="{Binding Summary.Summary}" Style="{StaticResource Dim}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                    Visibility="{Binding HasCompareChoices, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="Compare unlocks with" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding CompareChoices}" SelectedItem="{Binding CompareWith}" MinWidth="200"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CompareText}" Style="{StaticResource Mono}" Margin="0,0,0,10"
                                   Visibility="{Binding CompareText, Converter={StaticResource StringToVisible}}"/>

                        <Border Background="#2A2519" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="10" Margin="0,0,0,10"
                                Visibility="{Binding Selected.HasCarriedDrift, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="{Binding Selected.CarriedDriftText}"/>
                        </Border>

                        <!-- Progress made since capture -->
                        <Border Background="#2A2519" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="10" Margin="0,0,0,10"
                                Visibility="{Binding Selected.HasDrift, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="{Binding Selected.DriftText}"/>
                        </Border>

                        <!-- Why activation is unavailable -->
                        <Border Background="#2A1F1F" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                CornerRadius="4" Padding="10" Margin="0,0,0,10"
                                Visibility="{Binding HasBlockers, Converter={StaticResource BoolToVisible}}">
                            <StackPanel>
                                <TextBlock Text="Cannot load this set yet" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding BlockersText}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#2A2519" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="10" Margin="0,0,0,10"
                                Visibility="{Binding Selected.IsEmpty, Converter={StaticResource BoolToVisible}}">
                            <StackPanel>
                                <TextBlock Text="This set has no save in it yet" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Launch Isaac so it writes a fresh save, then capture it into this set. Until then there is nothing here to load."/>
                                <Button Content="Capture the new save" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CaptureIntoCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Load this save set" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ActivateCommand}" Margin="0,0,8,0"/>
                            <Button Content="Re-capture into this set" Command="{Binding CaptureIntoCommand}" Margin="0,0,8,0"
                                    ToolTip="Replace this set's files with whatever is live now."/>
                            <Button Content="Import a save file into a slot..." Command="{Binding ImportSaveFileCommand}" Margin="0,0,8,0"
                                    ToolTip="A downloaded fully-unlocked save, a friend's file, or one from REPENTOGON's save_backups. Checked as a save first."/>
                            <Button Content="Export as a file..." Command="{Binding ExportPackCommand}"
                                    ToolTip="The whole set as one .ipmsave file, for another machine or another person."/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Dim}" Margin="0,10,0,0"
                                   Text="Your current saves are backed up first. A set from the wrong build is blocked rather than warned about — loading a REPENTOGON-era save on retail can destroy every achievement."/>
                    </StackPanel>
                </Border>

                <!-- Earlier revisions of the selected set -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                    <StackPanel>
                        <TextBlock Text="History" Style="{StaticResource Heading}"/>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Every capture files the previous revision here first. Restoring one makes it the set's current contents; what is current now is filed too, so nothing is ever lost."/>
                        <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,8"
                                   Visibility="{Binding HasHistory, Converter={StaticResource BoolToCollapsed}}"
                                   Text="No earlier revisions yet. The first re-capture into this set creates one."/>
                        <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}"
                                 DisplayMemberPath="Label" MaxHeight="150" Margin="0,0,0,10"
                                 Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisible}}"/>
                        <Button Content="Restore this revision" Command="{Binding RestoreHistoryCommand}" HorizontalAlignment="Left"
                                Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisible}}"/>
                    </StackPanel>
                </Border>

                <!-- Edit the description after the fact -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                    <StackPanel>
                        <TextBlock Text="Edit this set" Style="{StaticResource Heading}"/>
                        <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,10"
                                   Text="Describes the set; never changes the save files, the recorded build or the hashes."/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Name" Style="{StaticResource Dim}"/>
                                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Players (comma separated)" Style="{StaticResource Dim}"/>
                                <TextBox Text="{Binding EditPlayers, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Notes" Style="{StaticResource Dim}"/>
                        <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="64" Margin="0,2,0,10"
                                 VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="Per-slot notes" Style="{StaticResource Dim}"/>
                        <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,6"
                                   Text="Which of the three slots is what — the thing that stops someone overwriting the wrong run."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Slot 1" VerticalAlignment="Center" Margin="0,0,10,6"/>
                            <TextBox  Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                                      Text="{Binding EditSlot1, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Slot 2" VerticalAlignment="Center" Margin="0,0,10,6"/>
                            <TextBox  Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                                      Text="{Binding EditSlot2, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Slot 3" VerticalAlignment="Center" Margin="0,0,10,10"/>
                            <TextBox  Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                                      Text="{Binding EditSlot3, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save changes" Command="{Binding SaveEditsCommand}" Margin="0,0,8,0"/>
                            <Button Content="Remove this set" Command="{Binding DeleteSetCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
