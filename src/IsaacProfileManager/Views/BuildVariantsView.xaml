<UserControl x:Class="IsaacProfileManager.Views.BuildVariantsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate x:Key="PatchRow">
            <Border Background="#15151A" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="4" Padding="12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                            <Border Background="{StaticResource Good}" CornerRadius="3" Padding="5,1"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding StateText, Converter={StaticResource StringToVisible}}">
                                <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Description}" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                   Margin="0,3,12,0"
                                   Visibility="{Binding Description, Converter={StaticResource StringToVisible}}"/>
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Mono}" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding AppliedText}" Style="{StaticResource Dim}" Margin="0,2,0,0"
                                   Visibility="{Binding AppliedText, Converter={StaticResource StringToVisible}}"/>

                        <Border Background="#2A2519" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="8" Margin="0,8,12,0"
                                Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="{Binding DriftText}" TextWrapping="Wrap" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="Apply" Style="{StaticResource PrimaryButton}" MinWidth="86"
                                Margin="0,0,0,6"
                                Command="{Binding DataContext.ApplyPatchCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsApplied, Converter={StaticResource BoolToCollapsed}}"/>
                        <Button Content="Revert" MinWidth="86" Margin="0,0,0,6"
                                Command="{Binding DataContext.RevertPatchCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisible}}"/>
                        <Button Content="Remove" MinWidth="86"
                                Command="{Binding DataContext.RemovePatchCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsApplied, Converter={StaticResource BoolToCollapsed}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,10">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding StateHeadline}" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StateDetail}" Style="{StaticResource Dim}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- The old junction, which patches cannot be laid over -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding BuildLinkIsJunction, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <TextBlock Text="This install still swaps whole build folders" Style="{StaticResource Heading}"/>
                    <TextBlock Text="{Binding JunctionMigrationText}" Style="{StaticResource Dim}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Turn the link into a real folder"
                            Command="{Binding CollapseJunctionCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Patches -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Patches" Style="{StaticResource Heading}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Add a patch..." Command="{Binding AddPatchCommand}" Margin="0,0,8,0"/>
                            <Button Content="Open folder" Command="{Binding OpenPatchesFolderCommand}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="A patch is an unzipped release laid over one of the game folders. Applying copies every file it replaces aside first and records what it did, so reverting puts the folder back exactly as it was. Nothing here keeps a second copy of the game."/>

                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Visibility="{Binding HasNoPatches, Converter={StaticResource BoolToVisible}}"
                               Text="No patches yet. Unzip one anywhere, then press &quot;Add a patch...&quot; and say which folder it belongs over."/>

                    <!-- Retail -->
                    <StackPanel Visibility="{Binding HasRootPatches, Converter={StaticResource BoolToVisible}}"
                                Margin="0,0,0,10">
                        <TextBlock Text="Over the retail install" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,8"
                                   Text="The game folder Steam owns - isaac-ng.exe and the loose dlls beside it."/>
                        <ItemsControl ItemsSource="{Binding RootPatches}" ItemTemplate="{StaticResource PatchRow}"/>
                    </StackPanel>

                    <!-- REPENTOGON -->
                    <StackPanel Visibility="{Binding HasRepentogonPatches, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="Over the REPENTOGON build" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,8"
                                   Text="The subfolder the launcher loads the downgraded build from."/>
                        <ItemsControl ItemsSource="{Binding RepentogonPatches}" ItemTemplate="{StaticResource PatchRow}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Switching -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsSwitchable, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <TextBlock Text="Switch build folder" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,10"
                               Text="Each folder in the build root is a complete build. Switching re-points the junction at a different one — nothing is copied, and neither folder is modified."/>

                    <ListBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}"
                             MaxHeight="180" Margin="0,0,0,12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
                                    <Border Background="{StaticResource Good}" CornerRadius="3" Padding="5,1" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <Border.Visibility>
                                            <MultiBinding Converter="{StaticResource EqualsToVisible}">
                                                <Binding/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=ListBox}"
                                                         Path="DataContext.Status.ActiveVariant"/>
                                            </MultiBinding>
                                        </Border.Visibility>
                                        <TextBlock Text="IN USE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="Switch to the selected build" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SwitchCommand}" HorizontalAlignment="Left"/>

                    <TextBlock Style="{StaticResource Dim}" Margin="0,12,0,0"
                               Text="Isaac must be closed. Repentogon\isaac-ng.exe refuses to be started directly, so launch through REPENTOGONLauncher.exe (or Steam, if your launch options point at it) for the change to take effect."/>
                </StackPanel>
            </Border>

            <!-- First-time setup -->
            <Border Style="{StaticResource Card}" Visibility="{Binding CanInitialize, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <TextBlock Text="First-time setup" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,10"
                               Text="Moves the installed build into the build root as 'Vanilla', copies it to a second folder named 'OnlineFix', and links the game's Repentogon\ folder back at 'Vanilla'. Both start out identical to what you already have installed; what you put in the second one afterwards is up to you."/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,10"
                               Text="Nothing is deleted at any point — the existing folder is moved, not copied and removed."/>

                    <Button Content="Set up build switching" Command="{Binding InitializeCommand}" HorizontalAlignment="Left"/>

                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Mono}" Margin="0,10,0,0"
                               Visibility="{Binding ProgressText, Converter={StaticResource StringToVisible}}"/>
                </StackPanel>
            </Border>

            <!-- Paths -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Paths" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="These say where things already are. Changing one moves nothing and copies nothing - if a path is wrong, the build link simply reads as missing until you correct it."/>

                    <TextBlock Text="Vanilla game directory" Style="{StaticResource Dim}"/>
                    <TextBlock Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"
                               Text="The retail install: the folder holding isaac-ng.exe and mods\."/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding GameDirDraft, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseGameDirCommand}"/>
                    </Grid>

                    <TextBlock Text="REPENTOGON subfolder" Style="{StaticResource Dim}"/>
                    <TextBlock Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"
                               Text="The folder the launcher loads the downgraded build from, and the one this tab re-points. A bare name is taken inside the game directory; the stock value is Repentogon."/>
                    <TextBox Text="{Binding LinkFolderDraft, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="Build root" Style="{StaticResource Dim}"/>
                    <TextBlock Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"
                               Text="One complete build per subfolder. Must not sit inside the subfolder above, or switching would take the other builds with it."/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding BuildRootDraft, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseBuildRootCommand}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Save paths" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SavePathsCommand}" Margin="0,0,8,0"/>
                        <Button Content="Reset" Command="{Binding ResetPathsCommand}" Margin="0,0,8,0"/>
                        <Button Content="Open build root" Command="{Binding OpenBuildRootCommand}"/>
                    </StackPanel>

                    <TextBlock Text="Build link resolves to" Style="{StaticResource Dim}"/>
                    <TextBlock Text="{Binding LinkPathText}" Style="{StaticResource Mono}" Margin="0,0,0,8"/>
                    <TextBlock Text="Build root resolves to" Style="{StaticResource Dim}"/>
                    <TextBlock Text="{Binding BuildRootText}" Style="{StaticResource Mono}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
