<UserControl x:Class="IsaacProfileManager.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:IsaacProfileManager.Views">

    <DockPanel Margin="0,14,0,10">
        <views:GuideCard DockPanel.Dock="Top" Title="Every mod you own, stored once"
                         Text="Pick a profile under Building, switch mods in or out, then Apply to profile. Updates asks the Workshop what changed; Share sends a profile or takes one in; Verify proves your files match a friend's byte for byte."/>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: everything you reach for often, on one line above the list -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filter the library by name"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <TextBlock Text="Building" Style="{StaticResource Dim}" VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding TargetProfile}"
                                  MinWidth="170"
                                  ToolTip="The profile the switches on this list add to and remove from"/>
                    </StackPanel>

                    <CheckBox Grid.Column="2" Content="In profile only" IsChecked="{Binding ShowOnlyIncluded}"
                              VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Button Grid.Column="3" Content="Apply to profile" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApplyCommand}" Margin="0,0,8,0"/>

                </Grid>

                <!--
                    The actions that used to hide behind a "..." button, named
                    for what they do. Three small menus, each labelled, so the
                    Workshop update cycle and sharing are discoverable without
                    knowing to click an ellipsis.
                -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Updates ▾" Click="OnOverflowClick" Margin="0,0,8,0"
                            ToolTip="Ask the Workshop what has changed, and pull the changes into the library">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Check for Workshop updates" Command="{Binding CheckUpdatesCommand}"/>
                                <MenuItem Header="Update everything stale" Command="{Binding UpdateStaleCommand}"/>
                                <MenuItem Header="Update the selected mod" Command="{Binding UpdateSelectedCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Share ▾" Click="OnOverflowClick" Margin="0,0,8,0"
                            ToolTip="Send a profile to someone, or take one in">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy a share code for this profile" Command="{Binding ShareProfileCommand}"/>
                                <MenuItem Header="Copy a share code for the whole library" Command="{Binding ShareLibraryCommand}"/>
                                <MenuItem Header="Import a share code..." Command="{Binding ImportShareCommand}"/>
                                <Separator/>
                                <MenuItem Header="Export this profile to a file..." Command="{Binding ExportProfileCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Verify ▾" Click="OnOverflowClick" Margin="0,0,8,0"
                            ToolTip="Prove your files match a friend's, byte for byte">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Record hashes" Command="{Binding RecordHashesCommand}"/>
                                <MenuItem Header="Verify library against them" Command="{Binding VerifyCommand}"/>
                                <MenuItem Header="Compare with someone's export..." Command="{Binding CompareCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="More ▾" Click="OnOverflowClick"
                            ToolTip="Bulk switches and the folder itself">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Switch on everything shown" Command="{Binding IncludeAllCommand}"/>
                                <MenuItem Header="Switch off everything shown" Command="{Binding IncludeNoneCommand}"/>
                                <Separator/>
                                <MenuItem Header="Open the library folder" Command="{Binding OpenLibraryCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Dim}"/>
                    <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Dim}" Margin="14,0,0,0"/>
                    <TextBlock Text="{Binding UpdateProgress}" Style="{StaticResource Mono}" Margin="14,0,0,0"/>
                    <TextBlock Text="{Binding HashProgress}" Style="{StaticResource Mono}" Margin="14,0,0,0"/>
                </StackPanel>

                <TextBlock Text="{Binding UpdateSummary}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Visibility="{Binding UpdateSummary, Converter={StaticResource StringToVisible}}"/>
            </StackPanel>
        </Border>

        <!-- Browser -->
        <Grid Grid.Row="1" Visibility="{Binding HasLibrary, Converter={StaticResource BoolToVisible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ToggleButton Grid.Column="0" Style="{StaticResource SwitchToggle}"
                                              IsChecked="{Binding InProfile}"
                                              VerticalAlignment="Center" Margin="0,0,12,0"
                                              ToolTip="On means this mod is in the profile named in Building"/>

                                <Border Grid.Column="1" Width="60" Height="60" Margin="0,0,12,0"
                                        Background="#121216" CornerRadius="4">
                                    <Image Stretch="UniformToFill"
                                           Source="{Binding PreviewPath, Converter={StaticResource PathToImage}}"/>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource Mono}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Visibility="{Binding SubtitleText, Converter={StaticResource StringToVisible}}"/>
                                    <TextBlock Text="{Binding UsedByText}" Style="{StaticResource Dim}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding UpdateText}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"
                                               Visibility="{Binding UpdateText, Converter={StaticResource StringToVisible}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                        <Setter Property="Foreground" Value="#E8B54A"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Detail -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                        <Border Background="#121216" CornerRadius="4" Padding="0" Margin="0,0,0,12"
                                HorizontalAlignment="Left">
                            <Image MaxHeight="200" MaxWidth="340" Stretch="Uniform"
                                   Source="{Binding Selected.PreviewPath, Converter={StaticResource PathToImage}}"/>
                        </Border>

                        <TextBlock Text="{Binding Selected.Name}" FontSize="18" FontWeight="SemiBold"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                            <TextBlock Text="{Binding Selected.OriginText}" Style="{StaticResource Dim}"/>
                            <TextBlock Text="{Binding DetailSizeText}" Style="{StaticResource Dim}" Margin="12,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="Library folder" Style="{StaticResource Dim}"/>
                        <TextBlock Text="{Binding Selected.Path}" Style="{StaticResource Mono}" Margin="0,0,0,8"/>

                        <TextBlock Text="Used by" Style="{StaticResource Dim}"/>
                        <TextBlock Text="{Binding Selected.UsedByText}" Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding Selected.Description}" Style="{StaticResource Dim}" Margin="0,0,0,12"/>

                        <WrapPanel>
                            <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,8,8"/>
                            <Button Content="Remove from library" Command="{Binding RemoveCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Dim}"
                                   Text="Removing is only offered for a mod no profile uses, and moves it to .backup rather than deleting it."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Empty library -->
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top"
                Visibility="{Binding HasLibrary, Converter={StaticResource BoolToCollapsed}}">
            <StackPanel>
                <TextBlock Text="Nothing here yet" Style="{StaticResource Heading}"/>
                <TextBlock Style="{StaticResource Dim}"
                           Text="Two ways to fill the library: import subscribed mods on the Workshop tab, or open a profile on the Mod profiles tab and convert its existing folders into library links."/>
            </StackPanel>
        </Border>

        <!-- Whatever the last verify or compare had to say -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0"
                Visibility="{Binding HasReport, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
                <TextBlock Text="{Binding ReportTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Report}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Mono}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

    </Grid>
    </DockPanel>
</UserControl>
