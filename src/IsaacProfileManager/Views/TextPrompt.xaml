<Window x:Class="IsaacProfileManager.Views.TextPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isaac Profile Manager" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Bg}">

    <StackPanel Margin="18">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock x:Name="Explanation" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBox x:Name="Entry" Margin="0,0,0,16" KeyDown="OnEntryKeyDown"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="90"
                    Click="OnAccept"/>
        </StackPanel>
    </StackPanel>
</Window>
