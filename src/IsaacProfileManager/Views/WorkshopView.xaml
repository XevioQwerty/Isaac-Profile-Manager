<UserControl x:Class="IsaacProfileManager.Views.WorkshopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0,14,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Shown instead of everything else when Steam's workshop cannot be found -->
        <Border Grid.Row="0" Grid.RowSpan="3" Style="{StaticResource Card}" VerticalAlignment="Top"
                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToCollapsed}}">
            <StackPanel>
                <TextBlock Text="Workshop not found" Style="{StaticResource Heading}"/>
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Dim}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Style="{StaticResource Card}"
                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
                <TextBlock Text="Import mods into your library" Style="{StaticResource Heading}"/>
                <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,8"
                           Text="Copies the mod out of Steam's content store into a folder named without the workshop id, so Steam has no claim on it. Do this while you are still subscribed — descriptions and previews cannot be captured afterwards."/>
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Mono}"/>
                <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="True"
                             Foreground="{StaticResource Accent}" Background="{StaticResource PanelAlt}"
                             BorderThickness="0"
                             Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisible}}"/>
            </StackPanel>
        </Border>

        <!-- Nothing subscribed: the intended end state once everything is imported -->
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top"
                Visibility="{Binding HasItems, Converter={StaticResource BoolToCollapsed}}">
            <StackPanel>
                <TextBlock Text="No subscriptions" Style="{StaticResource Heading}"/>
                <TextBlock Style="{StaticResource Dim}"
                           Text="Nothing is subscribed on Steam right now. If you have already imported and unsubscribed, that is the point — your mods live in the Library tab and nothing will be written into your profiles behind your back."/>
                <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,12"
                           Text="To add a mod later: subscribe on Steam, let it download, come back here and import it, then unsubscribe again."/>
                <WrapPanel>
                    <Button Content="Browse the Isaac Workshop" Command="{Binding BrowseWorkshopCommand}" Margin="0,0,8,0"/>
                    <Button Content="My subscribed items" Command="{Binding OpenSubscriptionsCommand}" Margin="0,0,8,0"/>
                    <Button Content="Open download folder" Command="{Binding OpenContentFolderCommand}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" Margin="0,0,14,12"
                     ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" Margin="0,0,10,0"
                                      VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Dim}"/>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Dim}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="2" Background="{StaticResource Good}" CornerRadius="3" Padding="5,1"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding InLibrary, Converter={StaticResource BoolToVisible}}">
                                <TextBlock Text="SAVED" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                        <Image Source="{Binding SelectedItem.PreviewPath, Converter={StaticResource PathToImage}}"
                               MaxHeight="150" HorizontalAlignment="Left" Margin="0,0,0,10" Stretch="Uniform"/>

                        <TextBlock Text="{Binding SelectedItem.Name}" FontSize="17" FontWeight="SemiBold"/>

                        <TextBlock Text="Steam would create" Style="{StaticResource Dim}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding SelectedItem.MaterialisedFolderName}" Style="{StaticResource Mono}"/>
                        <TextBlock Text="Library entry" Style="{StaticResource Dim}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SelectedItem.LibraryEntry}" Style="{StaticResource Mono}" Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding SelectedItem.Description}" Style="{StaticResource Dim}" Margin="0,0,0,10"/>

                        <Button Content="Open Workshop page" Command="{Binding OpenWorkshopPageCommand}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0"
                Visibility="{Binding HasItems, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
                <WrapPanel Margin="0,0,0,10">
                    <Button Content="Select all" Command="{Binding SelectAllCommand}" Margin="0,0,8,8"/>
                    <Button Content="Select none" Command="{Binding SelectNoneCommand}" Margin="0,0,8,8"/>
                    <Button Content="Select not-yet-imported" Command="{Binding SelectMissingCommand}" Margin="0,0,8,8"/>
                    <Button Content="Open library folder" Command="{Binding OpenLibraryCommand}" Margin="0,0,8,8"/>
                    <Button Content="Browse the Workshop" Command="{Binding BrowseWorkshopCommand}" Margin="0,0,8,8"/>
                    <Button Content="My subscribed items" Command="{Binding OpenSubscriptionsCommand}" Margin="0,0,8,8"/>
                    <Button Content="Unsubscribe from everything" Command="{Binding UnsubscribeAllCommand}" Margin="0,0,8,8"/>
                    <Button Content="Ask Steam what I'm subscribed to" Command="{Binding AskSteamCommand}" Margin="0,0,8,8"/>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                </WrapPanel>

                <CheckBox Content="Capture previews and descriptions from Steam during import"
                          IsChecked="{Binding FetchPreviews}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Dim}" Margin="22,0,0,12"
                           Text="Most Isaac mods ship no local thumbnail — the store image is server-side. This is the only chance to capture it, because unsubscribing removes Steam's copy of the item."/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Import selected into library" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ImportCommand}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
