<UserControl x:Class="IsaacProfileManager.Views.PlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:IsaacProfileManager.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,10">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <views:GuideCard Title="Start here"
                         Text="This card is what pressing Launch will do, read from disk: which mods, which save, which build, which version. Red blocks, amber recommends with a fix beside it. Mods, Saves and Game on the left are where you change any of those; Diagnose reads the last run's log."/>


            <!-- The pre-flight card: the five things Launch depends on, resolved from disk -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="What happens when you press Launch" Style="{StaticResource Heading}"/>
                            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                                       Text="Read from the mods link, the live save files, the launcher's ini and the last log — not from what this app last set."/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Re-check" Command="{Binding RefreshCommand}" VerticalAlignment="Top" Padding="10,3"/>
                    </Grid>

                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Mod profile" Style="{StaticResource Dim}"/>
                            <TextBlock Text="{Binding ProfileText}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ProfileDetail}" Style="{StaticResource Dim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Save set" Style="{StaticResource Dim}"/>
                            <TextBlock Text="{Binding SaveSetText}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SaveSetDetail}" Style="{StaticResource Dim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Launcher will start" Style="{StaticResource Dim}"/>
                            <TextBlock Text="{Binding BuildText}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,2"/>
                            <TextBlock Text="{Binding BuildDetail}" Style="{StaticResource Dim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Game version" Style="{StaticResource Dim}"/>
                            <TextBlock Text="{Binding VersionText}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,2"/>
                            <TextBlock Text="{Binding VersionDetail}" Style="{StaticResource Dim}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Findings, most severe first, each with its fix beside it -->
                    <ItemsControl ItemsSource="{Binding Findings}" Margin="0,0,0,4"
                                  Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisible}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding SeverityBrush}" BorderThickness="3,0,0,0"
                                        Background="{StaticResource PanelAlt}" CornerRadius="3" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{Binding SeverityBrush}" CornerRadius="3"
                                                Padding="7,2" VerticalAlignment="Top" Margin="0,1,12,0">
                                            <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{Binding FixText}" Command="{Binding FixCommand}"
                                                VerticalAlignment="Center" Margin="12,0,0,0"
                                                Visibility="{Binding HasFix, Converter={StaticResource BoolToVisible}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Sync with the other machine: the relation and the button that resolves it -->
                    <Border Background="{StaticResource PanelAlt}" CornerRadius="3" Padding="12,8" Margin="0,0,0,6"
                            BorderBrush="{Binding SyncBrush}" BorderThickness="3,0,0,0"
                            Visibility="{Binding HasSync, Converter={StaticResource BoolToVisible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SYNC" FontSize="10" FontWeight="Bold" Style="{StaticResource Dim}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding SyncText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="2" Content="Pull" Command="{Binding PullCommand}" Margin="12,0,0,0"
                                    Visibility="{Binding SyncCanPull, Converter={StaticResource BoolToVisible}}"
                                    ToolTip="Take the newer revision. If that set is live it is loaded, with every check."/>
                            <Button Grid.Column="3" Content="Push" Command="{Binding PushCommand}" Margin="8,0,0,0"
                                    Visibility="{Binding SyncNeedsPush, Converter={StaticResource BoolToVisible}}"
                                    ToolTip="Send this revision to your other machine."/>
                        </Grid>
                    </Border>

                    <!-- Launch row -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding LaunchCommand}" Style="{StaticResource PrimaryButton}"
                                Height="46" Padding="28,0" FontSize="16" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#x25B6;" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
                                <TextBlock Text="Launch Isaac" FontWeight="SemiBold" FontSize="16" Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{Binding VerdictBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding VerdictText}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LaunchHint}" Style="{StaticResource Dim}" Margin="17,2,0,0"/>
                        </StackPanel>

                        <!-- Fixes for the build this profile starts, beside the button that starts it -->
                        <Border Grid.Column="2" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="20" Padding="14,0" Height="42" VerticalAlignment="Center"
                                Visibility="{Binding HasQuickPatches, Converter={StaticResource BoolToVisible}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding QuickPatchHeader}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ItemsControl ItemsSource="{Binding QuickPatches}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding ShortName}" VerticalAlignment="Center" FontSize="12"
                                                           Margin="0,0,8,0" TextWrapping="NoWrap" ToolTip="{Binding DisplayName}"/>
                                                <ToggleButton Style="{StaticResource SwitchToggle}"
                                                              IsChecked="{Binding IsApplied, Mode=OneWay}"
                                                              VerticalAlignment="Center"
                                                              Command="{Binding DataContext.TogglePatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"
                                                              ToolTip="On lays this fix over the build this profile starts. Off takes it back off."/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Save-set-led launch -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,12">
                    <StackPanel>
                        <TextBlock Text="Play a save set" Style="{StaticResource Heading}"/>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Pick the set and press one thing: it is loaded, the mod profile it was made with is activated, the launcher is pointed at its build, and the game starts. Every check above still runs."/>
                        <ComboBox ItemsSource="{Binding SaveSetChoices}" SelectedItem="{Binding ChosenSaveSet}" Margin="0,0,0,10"/>
                        <Button Content="Load set, switch profile, launch" Command="{Binding PlaySetCommand}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Exit capture -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,12">
                    <StackPanel>
                        <TextBlock Text="When the game closes" Style="{StaticResource Heading}"/>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Isaac writes its save on exit. Until it is captured, the run you just played exists only in the live folder."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton GroupName="ExitCapture" Content="Off" Margin="0,0,14,0"
                                         IsChecked="{Binding ExitCaptureMode, Converter={StaticResource EqualsToBool}, ConverterParameter=Off}"/>
                            <RadioButton GroupName="ExitCapture" Content="Ask" Margin="0,0,14,0"
                                         IsChecked="{Binding ExitCaptureMode, Converter={StaticResource EqualsToBool}, ConverterParameter=Ask}"/>
                            <RadioButton GroupName="ExitCapture" Content="Automatic"
                                         IsChecked="{Binding ExitCaptureMode, Converter={StaticResource EqualsToBool}, ConverterParameter=Automatic}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ExitCaptureExplanation}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Content="Capture the last session now" Command="{Binding CaptureNowCommand}" HorizontalAlignment="Left"
                                ToolTip="For a session that ended while this app was closed. Runs the same check as the automatic one."/>
                        <TextBlock Text="{Binding LastSessionText}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding HasLastSession, Converter={StaticResource BoolToVisible}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
