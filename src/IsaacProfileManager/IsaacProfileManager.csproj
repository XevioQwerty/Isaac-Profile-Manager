<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IsaacProfileManager</AssemblyName>
    <RootNamespace>IsaacProfileManager</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Version and Product come from Directory.Build.props, so the app and the
         Steam helper can never disagree about which build they are. -->
    <Description>Switch Binding of Isaac mod profiles, saves and builds without a second install.</Description>

    <!-- Junction creation needs no elevation, and asking for it would make a
         folder-linking tool look like malware to a modding audience. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IsaacProfileManager.Core\IsaacProfileManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded as a resource as well as set on the exe, so the window and
         taskbar show it and not the default WPF icon. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <!--
    The Steam helper is a second executable, not a library, because Isaac ships
    only a 32-bit steam_api.dll and this app is x64. It cannot be a normal
    reference: it has to be published for win-x86 on its own and land beside the
    exe. In a dev build WorkshopPullService finds it in the helper's own bin
    folder instead, so only the release path needs this.
  -->
  <PropertyGroup>
    <SteamHelperProject>$(MSBuildThisFileDirectory)..\IsaacProfileManager.SteamHelper\IsaacProfileManager.SteamHelper.csproj</SteamHelperProject>
    <SteamHelperExe>$(MSBuildThisFileDirectory)..\IsaacProfileManager.SteamHelper\bin\$(Configuration)\net8.0\win-x86\publish\ipm-steam-helper.exe</SteamHelperExe>
  </PropertyGroup>

  <!--
    The file list is added inside the target, not as a static Content item: the
    helper does not exist when items are evaluated on a clean tree, so a static
    item silently publishes nothing. ExcludeFromSingleFile keeps it a loose exe
    beside the app instead of being bundled inside it, which is the whole point
    - a 64-bit bundle cannot run a 32-bit payload.
  -->
  <Target Name="PublishSteamHelper" BeforeTargets="ComputeResolvedFilesToPublishList">
    <Exec Command="dotnet publish &quot;$(SteamHelperProject)&quot; -c $(Configuration) --nologo -v quiet" />

    <Error Condition="!Exists('$(SteamHelperExe)')"
           Text="The Steam helper did not publish to $(SteamHelperExe). Shipping without it would leave the Workshop update feature dead." />

    <ItemGroup>
      <ResolvedFileToPublish Include="$(SteamHelperExe)">
        <RelativePath>ipm-steam-helper.exe</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
