{
  "name": "ipm-save-sync",
  "private": true,
  "version": "2.5.2",
  "description": "Lane store for Isaac Profile Manager save sync: a Cloudflare Worker over an R2 bucket.",
  "scripts": {
    "setup": "wrangler r2 bucket create ipm-saves",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --local --port 8787",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250901.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.114.0"
  }
}
